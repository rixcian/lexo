# Where the SQLite collection lives. Defaults to ./data/anki.db in development
# and /data/anki.db inside the container.
# ANKI_DB_PATH=./data/anki.db

# Folder holding the generated drizzle migrations. Defaults to ./drizzle.
# ANKI_MIGRATIONS_DIR=./drizzle

# The study day rolls over at 04:00 in this timezone.
# TZ=Europe/Prague

# Host port docker compose publishes.
# PORT=3000
